{
  "expo": {
    "name": "UniLink",
    "slug": "unilink",
    "version": "3.5",
    "orientation": "default",
    "icon": "./assets/images/app-icons/icon-original.png",
    "scheme": "unilink",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/images/app-icons/icon-original.png",
        "dark": "./assets/images/app-icons/icon-original.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icons/adaptive-icon-original.png",
        "backgroundColor": "#1a1a1a"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.unilink",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "notification": {
      "icon": "./assets/images/app-icons/notification-icon.png",
      "color": "#FF6D5D",
      "androidMode": "default",
      "androidCollapsedTitle": "#{unread_notifications} new notifications"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/app-icons/icon-original.png",
          "dark": {
            "image": "./assets/images/app-icons/icon-original.png",
            "backgroundColor": "#1a1a1a"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keep class expo.modules.notifications.** { *; }\n-keepclassmembers class * implements java.io.Serializable {\n  static final long serialVersionUID;\n  private void writeObject(java.io.ObjectOutputStream);\n  private void readObject(java.io.ObjectInputStream);\n  java.lang.Object writeReplace();\n  java.lang.Object readResolve();\n}"
          }
        }
      ],
      "./plugins/withGucAuth",
      "./plugins/withScheduleWidget",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-icons/notification-icon.png",
          "color": "#FF6D5D"
        }
      ],
      [
        "expo-dynamic-app-icon",
        {
          "blue": {
            "image": "./assets/images/app-icons/icon-blue.png",
            "prerendered": true
          },
          "gold": {
            "image": "./assets/images/app-icons/icon-gold.png",
            "prerendered": true
          },
          "black": {
            "image": "./assets/images/app-icons/icon-black.png",
            "prerendered": true
          },
          "white": {
            "image": "./assets/images/app-icons/icon-white.png",
            "prerendered": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b55d50f1-a6f1-4e96-90d8-c59a5eb8e733"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b55d50f1-a6f1-4e96-90d8-c59a5eb8e733"
    }
  }
}
